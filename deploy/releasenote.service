[Unit]
Description=ReleaseNote (Gunicorn / Flask)
After=network.target

[Service]
Type=simple
User=releasenote
Group=releasenote
WorkingDirectory=/opt/releasenote/current
EnvironmentFile=/etc/releasenote/releasenote.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/releasenote/current/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=3
# Hardening: the service can only write to its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/releasenote

[Install]
WantedBy=multi-user.target
