# Template for /etc/releasenote/releasenote.env (created automatically on first deploy,
# owner root:releasenote, mode 640). Never commit the real file.
APP_ENV=production
DATABASE_PATH=/var/lib/releasenote/releasenote.db
SECRET_KEY=<generated by deploy.sh>
# Hash from: sudo releasenote-manage hash-password   (keep the single quotes)
ADMIN_PASSWORD_HASH=''
AUTO_SEED=true
# Set to true only after HTTPS is configured:
SESSION_COOKIE_SECURE=false
